use YAML
use STD.FileSystem

func parsed(text:str) YAML.Document {
    return YAML.parse(text)
}

func parsed_stream(text:str) YAML.Stream {
    return YAML.parse_stream(text)
}

func mapping(value:YAML.Node, name:str) YAML.Node {
    return value.mapping(name)
}

func required(value:YAML.Node, name:str) YAML.Node {
    return value.require(name)
}

func sequence(value:YAML.Node, name:str) YAML.Node {
    return value.sequence(name)
}

func at(value:YAML.Node, index:int) YAML.Node {
    return value.at(index)
}

func integer(value:YAML.Node, name:str) int {
    return value.integer(name)
}

func boolean(value:YAML.Node, name:str) bool {
    return value.boolean(name)
}

func string(value:YAML.Node, name:str) str {
    return value.string(name)
}

func set_integer(value:YAML.Node, name:str, actual:int) {
    value.set(name, actual)
}

func set_boolean(value:YAML.Node, name:str, actual:bool) {
    value.set(name, actual)
}

func emitted(document:YAML.Document) str {
    return YAML.emit(document)
}

func written(path:str, document:YAML.Document) {
    YAML.write(path, document)
}

func read_document(path:str) YAML.Document {
    return YAML.read(path)
}

func anchor(value:YAML.Node) str {
    if name = value.anchor() { return name }
    panic("expected YAML anchor")
}

test "read and modify application configuration" {
    let source = "# Application settings\nwindow:\n  width: 1280\n  fullscreen: false\n"
    var document = parsed(source)
    var root = document.root()
    var window = mapping(root, "window")
    assert(integer(window, "width") == 1280, "YAML integer setting")
    assert(!boolean(window, "fullscreen"), "YAML boolean setting")
    set_integer(window, "width", 1920)
    set_boolean(window, "fullscreen", true)
    let actual = emitted(document)
    assert(actual == "# Application settings\nwindow:\n  width: 1920\n  fullscreen: true\n", "modified YAML configuration")
}

test "load and store a scene graph document" {
    let source = "scene: Demo\nentities:\n  - id: camera\n    transform:\n      position: [0, 2, 8]\n  - id: player\n    parent: world\n"
    var document = parsed(source)
    var root = document.root()
    assert(string(root, "scene") == "Demo", "scene name")
    var entities = sequence(root, "entities")
    assert(entities.count() == 2, "scene entities")
    var player = at(entities, 1)
    assert(string(player, "id") == "player", "scene entity identity")
    var reparsed = parsed(emitted(document))
    assert(sequence(reparsed.root(), "entities").count() == 2, "scene graph round trip")
}

test "parse an embedded-style string and a document stream" {
    let embedded = "defaults: &defaults\n  shadows: true\nquality:\n  settings: *defaults\n"
    var document = parsed(embedded)
    assert(anchor(mapping(document.root(), "defaults")) == "defaults", "YAML anchor")
    let encoded = emitted(document)
    assert(encoded.count() > 0, "anchored YAML emission")
    var documents = parsed_stream("---\nname: first\n---\nname: second\n")
    assert(documents.count() == 2, "YAML document stream")
}

test "write and read a local YAML file" {
    let path = "/private/tmp/silex-yaml-test.yml"
    let ignored = FileSystem.remove_file(path)
    var root = YAML.mapping()
    root.set("name", "local")
    root.set("workers", 4)
    var document = YAML.document(root)
    written(path, document)
    var loaded = read_document(path)
    assert(string(loaded.root(), "name") == "local", "local YAML string")
    assert(integer(loaded.root(), "workers") == 4, "local YAML integer")
    match FileSystem.remove_file(path) { failure(error) => { panic(error.detail) }; success => {} }
}

test "preserve YAML presentation and structured forms" {
    let source = "title: \"Sc\\u00e8ne\\nDemo\"\ndescription: |-\n  First line\n  Second line\nflags: [true, false, null]\nmaterial: {name: \"Steel\", roughness: 0.5}\nasset: !mesh models/player.mesh\n"
    var document = parsed(source)
    var root = document.root()
    var flags = sequence(root, "flags")
    assert(flags.count() == 3, "flow sequence")
    var material = mapping(root, "material")
    assert(string(material, "name") == "Steel", "flow mapping")
    var asset = required(root, "asset")
    if tag = asset.tag() { assert(tag == "mesh", "explicit YAML tag") }
    else { panic("explicit YAML tag was lost") }
    var reparsed = parsed(emitted(document))
    assert(string(reparsed.root(), "title") == "Scène\nDemo", "quoted scalar round trip")
}

test "explicit parse limits remain opt-in" {
    let options = YAML.ParseOptions(maximum_bytes:4, maximum_depth:8, maximum_documents:1, maximum_aliases:0)
    match YAML.try_parse("name: value", options) {
        success(document) => { panic("YAML input exceeded its explicit byte limit") }
        failure(error) => { assert(error.kind == YAML.ParseErrorKind.input_limit(), "YAML input limit error") }
    }
}

test "reject an alias without a preceding anchor" {
    match YAML.try_parse("value: *missing\n") {
        success(document) => { panic("unknown YAML alias was accepted") }
        failure(error) => { assert(error.kind == YAML.ParseErrorKind.unknown_anchor(), "unknown YAML anchor error") }
    }
}

test "plain URLs retain their colon" {
    var document = parsed("endpoint: https://registry.silex-lang.org/v1/index.json\nflow: {endpoint: https://silex-lang.org/docs/}\n")
    assert(string(document.root(), "endpoint") == "https://registry.silex-lang.org/v1/index.json", "block URL")
    assert(string(mapping(document.root(), "flow"), "endpoint") == "https://silex-lang.org/docs/", "flow URL")
}

test "reject tab indentation" {
    match YAML.try_parse("window:\n\twidth: 1280\n") {
        success(document) => { panic("tab-indented YAML was accepted") }
        failure(error) => { assert(error.kind == YAML.ParseErrorKind.invalid_indentation(), "tab indentation error") }
    }
}

test "structured YAML access failures remain opt in" {
    var document = parsed("name: Silex\nitems: [1]\n")
    var root = document.root()
    match root.try_require("missing") {
        success(value) => { panic("missing YAML key was returned") }
        failure(error) => {
            assert(error.kind == YAML.AccessErrorKind.missing_key(), "missing YAML key error")
        }
    }
    match root.try_integer("name") {
        success(value) => { panic("YAML string was projected as an integer") }
        failure(error) => { assert(error.kind == YAML.AccessErrorKind.invalid_scalar(), "YAML projection error") }
    }
    var items = root.sequence("items")
    match items.try_at(2) {
        success(value) => { panic("out-of-bounds YAML node was returned") }
        failure(error) => { assert(error.kind == YAML.AccessErrorKind.index_out_of_bounds(), "YAML index error") }
    }
    match root.try_append(YAML.string("invalid")) {
        success => { panic("node was appended to a YAML mapping") }
        failure(error) => { assert(error.kind == YAML.AccessErrorKind.wrong_kind(), "YAML mutation error") }
    }
}

test "structured YAML construction and emission failures remain opt in" {
    match YAML.try_number_text("not-a-number") {
        success(value) => { panic("invalid YAML number was constructed") }
        failure(error) => { assert(error.kind == YAML.BuildErrorKind.invalid_number(), "YAML number build error") }
    }
    match YAML.try_alias("invalid alias") {
        success(value) => { panic("invalid YAML alias was constructed") }
        failure(error) => { assert(error.kind == YAML.BuildErrorKind.invalid_alias(), "YAML alias build error") }
    }
    var document = parsed("name: Silex\n")
    match YAML.try_emit(document, YAML.EmitOptions(indentation:0)) {
        success(text) => { panic("invalid YAML indentation was accepted") }
        failure(error) => { assert(error.kind == YAML.EmitErrorKind.invalid_indentation(), "YAML emission error") }
    }
}
